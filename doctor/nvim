#!/usr/bin/env bash
# doctor/nvim — version >= 0.9, lazy.nvim managing > 0 plugins, lazy-lock.json present.
set -euo pipefail
cd "$(dirname "${BASH_SOURCE[0]}")/.."
source lib/os.sh

# 1) binary version >= 0.9
line="$(nvim --version | head -1)"
v="${line#NVIM v}"; v="${v%% *}"
if [ -n "$v" ] && [ "$v" != "$line" ]; then
  if [ "$(printf '%s\n%s\n' "0.9" "$v" | sort -V | head -1)" = "0.9" ]; then
    echo "ok: nvim $v (>= 0.9)"
  else
    echo "FAIL: nvim $v < 0.9" >&2; exit 1
  fi
else
  echo "FAIL: cannot parse nvim version from: $line" >&2; exit 1
fi

# 2) lazy.nvim plugin count > 0
out="$(nvim --headless "+lua print(#require('lazy').plugins())" +qa 2>&1)" || true
n="$(printf '%s\n' "$out" | grep -Eo '^[0-9]+$' | tail -1)"
if [ -n "${n:-}" ] && [ "$n" -gt 0 ]; then
  echo "ok: lazy.nvim plugins: $n"
else
  echo "FAIL: lazy.nvim plugin count not > 0 (output: ${out:-<empty>})" >&2; exit 1
fi

# 3) lazy-lock.json present in the active config
if [ -f "$HOME/.config/nvim/lazy-lock.json" ]; then
  echo "ok: lazy-lock.json present"
else
  echo "FAIL: missing ~/.config/nvim/lazy-lock.json" >&2; exit 1
fi
echo "doctor/nvim: PASS"
