#!/usr/bin/env bash
# installers/searxng — deps for the local SearXNG: uv (runtimes) + git (OS).
set -euo pipefail
cd "$(dirname "${BASH_SOURCE[0]}")/.."
source lib/os.sh

# uv — mise-pinned, idempotent
command -v uv >/dev/null || ./installers/runtimes
echo "ok: uv $(uv --version | awk '{print $2}')"

# git — system package
case "$OS" in
  mac)
    command -v git >/dev/null || { echo "need git — install Xcode Command Line Tools (xcode-select --install)" >&2; exit 1; }
    ;;
  arch)   sudo pacman -S --needed git ;;
  ubuntu) sudo apt-get install -y git ;;
  *) echo "installers/searxng: unsupported OS: $OS" >&2; exit 1 ;;
esac
echo "ok: git $(git version | awk '{print $3}')"
echo "installed: searxng deps (uv, git) for $OS"
