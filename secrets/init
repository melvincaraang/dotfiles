#!/usr/bin/env bash
# secrets/init — create .env (if missing) and pre-fill from existing local
# files, non-interactively:
#   CONTEXT7_API_KEY   <- ~/.config/context7.env
#   CLICKUP_API_TOKEN  <- ~/.config/clickup.env
#   SEARXNG_SECRET_KEY <- ~/tools/searxng/settings.yml (keeps the local clone's
#                         secret stable when searxng/bootstrap adopts it)
#   OLLAMA_BASE_URL    <- ~/.pi/agent/models.json (first baseUrl found)
#   AWS_PROFILE        <- ~/.zshrc (export AWS_PROFILE=...)
# Non-destructive: a machine source replaces an empty value or the shipped
# .env.example placeholder, but never overwrites a value the user set.
# Anything still empty is prompted for (interactive runs only);
# SEARXNG_SECRET_KEY falls back to a generated 64-hex key.
# Prints the names of every variable it filled — never the values.
set -euo pipefail
cd "$(dirname "${BASH_SOURCE[0]}")/.."

# value of $1 in FILE $2 ("" if unset); inline comments and padding stripped
env_value() {
  sed -nE "s/^[[:space:]]*$1[[:space:]]*=[[:space:]]*(.*)$/\1/p" "$2" 2>/dev/null | head -n1 \
    | sed -E 's/[[:space:]]#.*$//; s/^#.*$//' | sed -E 's/^[[:space:]]+//; s/[[:space:]]+$//'
}

FILLED=()

# set VAR=$2, unless the user already set a custom (non-placeholder) value
set_value() {
  local var="$1" val="${2:-}"
  [ -n "$val" ] || return 0
  local cur def esc tmp
  cur="$(env_value "$var" .env)"
  def="$(env_value "$var" .env.example)"
  if [ -n "$cur" ] && [ "$cur" != "$def" ]; then
    return 0   # user-set value — never overwrite
  fi
  esc="$(printf '%s' "$val" | sed -e 's/[&/\]/\\&/g')"
  tmp="$(mktemp)"
  sed -E "s/^[[:space:]]*$var[[:space:]]*=.*$/$var=$esc/" .env > "$tmp"
  mv "$tmp" .env
  [ "$cur" = "$val" ] || FILLED+=("$var")
}

[ -f .env ] || { cp .env.example .env; echo ".env created from .env.example"; }

# ── pre-fill from existing local files (machine sources) ──
set_value CONTEXT7_API_KEY "$(grep -h '^CONTEXT7_API_KEY=' ~/.config/context7.env 2>/dev/null | cut -d= -f2- | head -n1)"
set_value CLICKUP_API_TOKEN "$(grep -h '^CLICKUP_API_TOKEN=' ~/.config/clickup.env 2>/dev/null | cut -d= -f2- | head -n1)"
set_value SEARXNG_SECRET_KEY "$(sed -nE 's/^[[:space:]]*secret_key:[[:space:]]*\"([^\"]*)\".*/\1/p' ~/tools/searxng/settings.yml 2>/dev/null | head -n1)"
set_value OLLAMA_BASE_URL "$(python3 - "$HOME/.pi/agent/models.json" 2>/dev/null <<'PY'
import json, sys
try:
    d = json.load(open(sys.argv[1]))
except Exception:
    sys.exit(0)
found = []
def walk(o):
    if isinstance(o, dict):
        for k, v in o.items():
            if k == "baseUrl" and isinstance(v, str):
                found.append(v)
            walk(v)
    elif isinstance(o, list):
        for v in o:
            walk(v)
walk(d)
if found:
    print(found[0])
PY
)"
set_value AWS_PROFILE "$(grep -m1 -E '^(export[[:space:]]+)?AWS_PROFILE=' ~/.zshrc 2>/dev/null | sed -E 's/^.*AWS_PROFILE=//')"

# ── interactive fallback: prompt for still-empty *_KEY / *_TOKEN vars ──
# (skipped when stdin is not a TTY — machine sources above must cover them)
if [ -t 0 ]; then
  for var in CONTEXT7_API_KEY CLICKUP_API_TOKEN SEARXNG_SECRET_KEY; do
    [ -z "$(env_value "$var" .env)" ] && continue
    printf '%s: ' "$var"
    IFS= read -rs reply || reply=""
    [ -n "$reply" ] && printf '%*s\n' "${#reply}" '' | tr ' ' '*'
    if [ -n "$reply" ]; then
      set_value "$var" "$reply"
    fi
  done
fi

# ── SEARXNG_SECRET_KEY: generate if still empty ──
if [ -z "$(env_value SEARXNG_SECRET_KEY .env)" ]; then
  set_value SEARXNG_SECRET_KEY "$(openssl rand -hex 32)"
fi

# ── report (names only, never values) ──
if [ "${#FILLED[@]}" -gt 0 ]; then
  for v in "${FILLED[@]}"; do
    echo "filled: $v"
  done
else
  echo "filled: (none — .env already complete)"
fi
echo ".env ready"
