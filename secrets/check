#!/usr/bin/env bash
# secrets/check — audit .env. Prints a `VAR | set|empty` table (names only —
# never values, never partial values). Exits non-zero if any REQUIRED var is
# empty: OLLAMA_BASE_URL PI_SEARXNG_URL CONTEXT7_API_KEY CLICKUP_API_TOKEN.
# SEARXNG_HOME / SEARXNG_PORT / AWS_PROFILE have working defaults
# (.env.example) and are shown for information.
set -euo pipefail
cd "$(dirname "${BASH_SOURCE[0]}")/.."

if [ ! -f .env ]; then
  echo "error: .env not found — run: just secrets" >&2
  exit 1
fi

# value of $1 in .env ("" if unset); inline comments and padding stripped
env_value() {
  sed -nE "s/^[[:space:]]*$1[[:space:]]*=[[:space:]]*(.*)$/\1/p" .env 2>/dev/null | head -n1 \
    | sed -E 's/[[:space:]]#.*$//; s/^#.*$//' | sed -E 's/^[[:space:]]+//; s/[[:space:]]+$//'
}

VARS="OLLAMA_BASE_URL SEARXNG_HOME SEARXNG_PORT SEARXNG_SECRET_KEY PI_SEARXNG_URL CONTEXT7_API_KEY CLICKUP_API_TOKEN AWS_PROFILE"
REQUIRED="OLLAMA_BASE_URL PI_SEARXNG_URL CONTEXT7_API_KEY CLICKUP_API_TOKEN"

ok=1
missing=""
for var in $VARS; do
  if [ -n "$(env_value "$var")" ]; then
    printf '%-22s set\n' "$var"
  else
    printf '%-22s empty\n' "$var"
    case " $REQUIRED " in
      *" $var "*) ok=0; missing="$missing $var" ;;
    esac
  fi
done

if [ "$ok" -ne 1 ]; then
  echo "secrets check: FAILED — required empty:$missing (fix: just secrets)" >&2
  exit 1
fi
echo "secrets check: ok — all required values set"
