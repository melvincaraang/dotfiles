#!/usr/bin/env bash
# searxng/bootstrap — clone-if-absent, render settings.yml from the in-repo
# template via envsubst (secret from .env), ensure a .venv. The rendered
# settings.yml stays machine-local in $SEARXNG_HOME (outside this repo).
set -euo pipefail
cd "$(dirname "${BASH_SOURCE[0]}")/.."
source lib/os.sh
: "${SEARXNG_HOME:?run: just secrets}"; : "${SEARXNG_SECRET_KEY:?}"
mkdir -p "$SEARXNG_HOME"
cd "$SEARXNG_HOME"
[ -d .git ] || git clone https://github.com/searxng/searxng .
envsubst < "$ROOT/searxng/settings.yml.template" > settings.yml
[ -d .venv ] || ( uv venv .venv --python 3.13 && uv pip install -r requirements.txt )
echo "bootstrapped: $SEARXNG_HOME (settings.yml rendered, .venv ready)"
