#!/usr/bin/env bash
set -euo pipefail
cd "$(dirname "${BASH_SOURCE[0]}")/.."
tool="${1:-all}"
case "$tool" in
  all) for t in kitty nvim tmux pi searxng zsh; do ./syncers/"$t"; done ;;
  secrets|uv|node|ripgrep|fzf|awscli|just|os-packages|runtimes) ./syncers/"$tool" ;;
  kitty|nvim|tmux|pi|searxng|zsh)
    [ -x "./syncers/$tool" ] || { echo "syncers/$tool not implemented yet (later task)"; exit 0; }
    ./syncers/"$tool" ;;
  *) echo "unknown: $tool (try: all | secrets | kitty nvim tmux pi searxng zsh | uv node ripgrep fzf awscli just)" >&2; exit 2 ;;
esac
