#!/usr/bin/env bash
# syncers/zsh — generate a managed ~/.zshrc from the committed fragments
# (zsh/base.zsh + zsh/$OS.zsh + optional machine tail ~/.zshrc.local).
# GUARDED adoption: on the first run on an established machine the existing
# ~/.zshrc is copied to ~/.zshrc.bak-<ts> and moved to ~/.zshrc.legacy, and
# a ~/.zshrc.dotfiles-adopted marker is dropped — re-runs never clobber again.
set -euo pipefail
cd "$(dirname "${BASH_SOURCE[0]}")/.."
source lib/os.sh

if [ -f ~/.zshrc ]; then
  # never clobber an existing user shell on an established machine:
  cp -n ~/.zshrc "$HOME/.zshrc.bak-$(date +%Y%m%d-%H%M%S)" 2>/dev/null || true
  [ -f ~/.zshrc.dotfiles-adopted ] || { mv ~/.zshrc ~/.zshrc.legacy; : > ~/.zshrc.dotfiles-adopted; }
fi
cat > ~/.zshrc <<EOF
# generated by dotfiles (\`just sync zsh\`) — machine tail: ~/.zshrc.local
source "$ROOT/zsh/base.zsh"
source "$ROOT/zsh/$OS.zsh"
[ -f "$HOME/.zshrc.local" ] && source "$HOME/.zshrc.local"
EOF
echo "zshrc managed; old one preserved at ~/.zshrc.legacy (on first run)"
