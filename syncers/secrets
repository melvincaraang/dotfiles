#!/usr/bin/env bash
# syncers/secrets — render per-tool env artifacts from .env (idempotent).
# All templates use ${VAR} syntax for envsubst — never {{VAR}}.
# SearXNG's settings.yml render is owned by searxng/bootstrap (Task 8) —
# deliberately NOT duplicated here.
set -euo pipefail
cd "$(dirname "${BASH_SOURCE[0]}")/.."
ROOT="$(pwd)"

if [ ! -f .env ]; then
  echo "error: .env not found — run: just secrets" >&2
  exit 1
fi
set -a
. ./.env
set +a

# context7 — pi's context7 tool
if [ -n "${CONTEXT7_API_KEY:-}" ]; then
  mkdir -p ~/.config
  printf '%s\n' "CONTEXT7_API_KEY=${CONTEXT7_API_KEY}" > ~/.config/context7.env
  echo "rendered: ~/.config/context7.env"
fi

# clickup
if [ -n "${CLICKUP_API_TOKEN:-}" ]; then
  mkdir -p ~/.config
  printf '%s\n' "CLICKUP_API_TOKEN=${CLICKUP_API_TOKEN}" > ~/.config/clickup.env
  echo "rendered: ~/.config/clickup.env"
fi

# pi searxng config
mkdir -p ~/.pi
echo "{\"searxngUrl\":\"${PI_SEARXNG_URL}\",\"timeoutMs\":15000,\"maxResults\":10}" > ~/.pi/searxng.json
echo "rendered: ~/.pi/searxng.json"

# pi models.json — template lands in Task 7; this guard keeps Task 2 alone runnable
[ -f "$ROOT/pi/agent/models.json.template" ] || exit 0
mkdir -p ~/.pi/agent
envsubst < "$ROOT/pi/agent/models.json.template" > ~/.pi/agent/models.json
echo "rendered: ~/.pi/agent/models.json"
